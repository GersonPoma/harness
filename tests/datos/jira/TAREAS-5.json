{
 "key": "TAREAS-5",
 "fields": {
  "summary": "Eliminar tareas",
  "description": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Como usuario de la API quiero eliminar tareas que ya no necesito."
      }
     ],
     "attrs": {
      "localId": "b68eb8d8cfa7"
     }
    },
    {
     "type": "panel",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Agregar el endpoint DELETE /tareas/{id}."
        }
       ],
       "attrs": {
        "localId": "389624743d85"
       }
      }
     ],
     "attrs": {
      "panelType": "info",
      "localId": "ce3b231870de"
     }
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Criterios de aceptación:"
      }
     ],
     "attrs": {
      "localId": "025cb10ca893"
     }
    },
    {
     "type": "orderedList",
     "attrs": {
      "order": 1,
      "localId": "9f79dda17cb0"
     },
     "content": [
      {
       "type": "listItem",
       "attrs": {
        "localId": "90646a026c3c"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Si la tarea existe, se elimina y la API responde 204 sin cuerpo."
          }
         ],
         "attrs": {
          "localId": "ca4ef9cc5a73"
         }
        }
       ]
      },
      {
       "type": "listItem",
       "attrs": {
        "localId": "a53b63fd2739"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Si no existe, responde 404 con el detalle de abajo."
          }
         ],
         "attrs": {
          "localId": "01f612279afc"
         }
        }
       ]
      },
      {
       "type": "listItem",
       "attrs": {
        "localId": "3c08910f59bc"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Después de eliminarla, ya no aparece en GET /tareas."
          }
         ],
         "attrs": {
          "localId": "e3603be57bb2"
         }
        }
       ]
      },
      {
       "type": "listItem",
       "attrs": {
        "localId": "66dc2a6de386"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Los ids de las tareas que quedan no cambian."
          }
         ],
         "attrs": {
          "localId": "ca498d8c3cdf"
         }
        }
       ]
      },
      {
       "type": "listItem",
       "attrs": {
        "localId": "cc1ca1d66322"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Tests para cada caso."
          }
         ],
         "attrs": {
          "localId": "ed19d08bc4f0"
         }
        }
       ]
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Respuesta cuando no existe:"
      }
     ],
     "attrs": {
      "localId": "1e68369bda40"
     }
    },
    {
     "type": "codeBlock",
     "attrs": {
